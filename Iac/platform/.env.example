# 本地教学网页登录使用 admin/admin。运行 init 自动生成其他随机机密。
# .env 和 secrets/ 已被 Git 忽略；复刻时每个人独立生成。
IAC_PROJECT_DIR=/absolute/path/to/Iac
# 留空跟随本机架构；仅在需要兼容模式时设置 linux/amd64。
NETBOX_PLATFORM=
SEMAPHORE_PORT=3001
DB_PASSWORD=generated-by-init
REDIS_PASSWORD=generated-by-init
NETBOX_SECRET_KEY=generated-by-init
NETBOX_TOKEN_PEPPER=generated-by-init
NETBOX_ADMIN_PASSWORD=admin
NETBOX_WRITE_TOKEN_KEY=generated-by-init
NETBOX_WRITE_TOKEN_SECRET=generated-by-init
NETBOX_READ_TOKEN_KEY=generated-by-init
NETBOX_READ_TOKEN_SECRET=generated-by-init
SEMAPHORE_ADMIN_PASSWORD=admin
SEMAPHORE_ACCESS_KEY_ENCRYPTION=generated-by-init
